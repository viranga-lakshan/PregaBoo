<?xml version="1.0" encoding="utf-8"?>
<AbsoluteLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_x="16dp"
        android:layout_y="16dp"
        android:src="@drawable/baseline_arrow_back_24"
        android:contentDescription="Back Button" />

    <!-- Title -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="80dp"
        android:layout_y="16dp"
        android:text="Add New Payment Address"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Full Name Label -->
    <TextView
        android:id="@+id/fullNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="16dp"
        android:layout_y="80dp"
        android:text="Full Name"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- Full Name Input -->
    <EditText
        android:id="@+id/fullNameInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_x="16dp"
        android:layout_y="110dp"
        android:layout_marginEnd="16dp"

        android:hint="Placeholders"
        android:textColorHint="#B3B3B3"
        android:padding="8dp" />

    <!-- Street Address Label -->
    <TextView
        android:id="@+id/streetAddressLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="16dp"
        android:layout_y="170dp"
        android:text="Street Address"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- Street Address Input -->
    <EditText
        android:id="@+id/streetAddressInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_x="16dp"
        android:layout_y="200dp"
        android:layout_marginEnd="16dp"

        android:hint="Placeholders"
        android:textColorHint="#B3B3B3"
        android:padding="8dp" />

    <!-- State Label -->
    <TextView
        android:id="@+id/stateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="16dp"
        android:layout_y="260dp"
        android:text="State"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- State Input -->
    <EditText
        android:id="@+id/stateInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_x="16dp"
        android:layout_y="290dp"
        android:layout_marginEnd="16dp"

        android:hint="Placeholders"
        android:textColorHint="#B3B3B3"
        android:padding="8dp" />

    <!-- City Label -->
    <TextView
        android:id="@+id/cityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="16dp"
        android:layout_y="350dp"
        android:text="City"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- City Input -->
    <EditText
        android:id="@+id/cityInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_x="16dp"
        android:layout_y="380dp"
        android:layout_marginEnd="16dp"

        android:hint="Placeholders"
        android:textColorHint="#B3B3B3"
        android:padding="8dp" />

    <!-- Postal Code Label -->
    <TextView
        android:id="@+id/postalCodeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="16dp"
        android:layout_y="440dp"
        android:text="Postal Code"
        android:textColor="#000000"
        android:textSize="14sp" />

    <!-- Postal Code Input -->
    <EditText
        android:id="@+id/postalCodeInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_x="16dp"
        android:layout_y="470dp"
        android:layout_marginEnd="16dp"

        android:hint="Placeholders"
        android:textColorHint="#B3B3B3"
        android:padding="8dp" />

    <!-- Set As Default Switch -->
    <Switch
        android:id="@+id/defaultSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_x="16dp"
        android:layout_y="530dp"
        android:text="SET AS DEFAULT"
        android:textColor="#000000" />

    <!-- Delete Button -->

    <!-- Save Button -->
    <Button
        android:id="@+id/deleteButton"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_x="44dp"
        android:layout_y="634dp"
        android:backgroundTint="#6A5ACD"
        android:text="Delete"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/saveButton"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_x="260dp"
        android:layout_y="633dp"
        android:backgroundTint="#6A5ACD"
        android:text="Save"
        android:textColor="#FFFFFF" />

</AbsoluteLayout>
