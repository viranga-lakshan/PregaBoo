<android.widget.AbsoluteLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header with Profile -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/gradient_background"
        android:layout_x="0dp"
        android:layout_y="0dp"
        android:padding="16dp">

        <ImageView
            android:id="@+id/profilePicture"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/baseline_account_circle_24"
            android:scaleType="centerCrop"
            android:src="@drawable/sample_profile" />

        <TextView
            android:id="@+id/userName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vimasha"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/userDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="India • English"
            android:textSize="14sp"
            android:textColor="#B0B0B0" />
    </LinearLayout>

    <!-- Back Button -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_arrow_back_24"
        android:layout_x="16dp"
        android:layout_y="16dp" />

    <!-- Button Row (Horizontal Layout with Two Columns) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_x="0dp"
        android:layout_y="216dp">

        <!-- First Vertical LinearLayout with 3 Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGrowth"
                style="@style/Widget.MaterialComponents.Button"
                android:text="Growth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                android:layout_marginBottom="8dp"
                android:cornerRadius="16dp"
                android:elevation="4dp"
                android:padding="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonVaccine"
                style="@style/Widget.MaterialComponents.Button"
                android:text="Vaccine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                android:layout_marginBottom="8dp"
                android:cornerRadius="16dp"
                android:elevation="4dp"
                android:padding="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSleep"
                style="@style/Widget.MaterialComponents.Button"
                android:text="Sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                android:cornerRadius="16dp"
                android:elevation="4dp"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- Second Vertical LinearLayout with 3 Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDiaper"
                style="@style/Widget.MaterialComponents.Button"
                android:text="Diaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                android:layout_marginBottom="8dp"
                android:cornerRadius="16dp"
                android:elevation="4dp"
                android:padding="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDoctorVisits"
                style="@style/Widget.MaterialComponents.Button"
                android:text="Doctor Visits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                android:layout_marginBottom="8dp"
                android:cornerRadius="16dp"
                android:elevation="4dp"
                android:padding="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button6"
                style="@style/Widget.MaterialComponents.Button"
                android:text="Button 6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6200EE"
                android:cornerRadius="16dp"
                android:elevation="4dp"
                android:padding="12dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Reminders Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        android:layout_width="377dp"
        android:layout_height="48dp"
        android:text="Reminders"
        android:layout_margin="16dp"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        android:layout_x="16dp"
        android:layout_y="580dp"
        android:cornerRadius="16dp"
        android:elevation="6dp"
        android:padding="12dp"/>

    <!-- Delete Account Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button3"
        android:layout_width="377dp"
        android:layout_height="48dp"
        android:text="Delete Account"
        android:layout_margin="16dp"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:layout_x="16dp"
        android:layout_y="628dp"
        android:cornerRadius="16dp"
        android:elevation="6dp"
        android:padding="12dp"/>

</android.widget.AbsoluteLayout>
