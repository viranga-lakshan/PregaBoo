<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clinic Visit Details"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal" />

            <!-- Visit Date -->
            <TextView
                android:id="@+id/visit_date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visit Date"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />

            <DatePicker
                android:id="@+id/visit_date_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Visit Time -->
            <TextView
                android:id="@+id/visit_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visit Time"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />

            <TimePicker
                android:id="@+id/visit_time_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Purpose -->
            <TextView
                android:id="@+id/purpose_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Purpose"
                android:textSize="18sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/purpose_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Purpose"
                android:background="@android:color/white"
                android:padding="8dp"
                android:layout_marginTop="8dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:layout_marginTop="16dp"
                android:layout_gravity="center_horizontal" />

            <!-- RecyclerView to show added dates -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dates_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@android:color/white"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>